# 首次运行：npm run setup。不要把真实密码写入此文件或提交到 Git。

# 服务监听与数据存储
LANVORYN_HOST=0.0.0.0
LANVORYN_PORT=3210
LANVORYN_DATA_DIR=./data

# 音视频采集与工具
# linux：真实 USB 设备；demo：明确标记的测试画面与测试音，绝不自动降级。
LANVORYN_SOURCE=linux
LANVORYN_FFMPEG=ffmpeg
LANVORYN_V4L2_CTL=v4l2-ctl

# MediaMTX 内部连接（仅本机访问）
LANVORYN_MEDIAMTX_WEBRTC=http://127.0.0.1:8889
LANVORYN_MEDIAMTX_API=http://127.0.0.1:9997
LANVORYN_RTSP_URL=rtsp://127.0.0.1:8554/live

# 局域网媒体连接地址
# 生成 MediaMTX 配置时使用：填写其他设备能够访问的服务器局域网 IP。
LANVORYN_MEDIA_HOST=127.0.0.1

# 登录会话与 Cookie
LANVORYN_SESSION_HOURS=12
# 使用 HTTPS 时设为 true；直连局域网 HTTP 时保持 false。
LANVORYN_SECURE_COOKIE=false

# 网页来源与网络访问限制
# 可选，只接受该 Origin 的写操作；例如 https://camera.example.com
LANVORYN_PUBLIC_ORIGIN=
# 可选，逗号分隔的 IPv4/IPv6 CIDR；设置后仅这些来源可访问。
LANVORYN_ALLOWED_CIDRS=
