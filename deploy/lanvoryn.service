[Unit]
Description=Lanvoryn private audio and video console
Wants=network-online.target lanvoryn-media.service
After=network-online.target lanvoryn-media.service

[Service]
Type=simple
User=lanvoryn
Group=lanvoryn
SupplementaryGroups=video audio
WorkingDirectory=/opt/lanvoryn
EnvironmentFile=/etc/lanvoryn/lanvoryn.env
ExecStart=/usr/bin/node /opt/lanvoryn/apps/server/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lanvoryn
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
