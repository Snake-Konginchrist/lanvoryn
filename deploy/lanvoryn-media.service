[Unit]
Description=Lanvoryn MediaMTX streaming service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_GROUP@
WorkingDirectory=/var/lib/lanvoryn
ExecStart=/opt/lanvoryn/bin/mediamtx /etc/lanvoryn/mediamtx.yml
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lanvoryn
# MediaMTX 枚举 WebRTC 网卡候选地址需要 AF_NETLINK。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
