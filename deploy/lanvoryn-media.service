[Unit]
Description=Lanvoryn MediaMTX streaming service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lanvoryn
Group=lanvoryn
WorkingDirectory=/var/lib/lanvoryn
ExecStart=/opt/lanvoryn/bin/mediamtx /etc/lanvoryn/mediamtx.yml
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lanvoryn
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
